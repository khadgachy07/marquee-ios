<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by xtool into the app's Info.plist. -->
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Marquee</string>
    <!-- Keep audio going when the screen locks, and for Picture in Picture. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- Jellyfin is reached over plain HTTP on your Tailscale network (by IP address, which ATS
         exceptions can't name), so allow HTTP. Remove this if you move to HTTPS. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Marquee connects to your Jellyfin server on your network.</string>
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>
    <!-- An empty launch screen dict makes the app use the full modern screen size. -->
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
